<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Campo de autocompletado (opcional) -->
        <AutoCompleteTextView
            android:id="@+id/miAutoComplete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Elige una opcion"
            android:completionThreshold="4"
            android:layout_marginBottom="16dp" />

        <!-- Imagen superior -->
        <ImageButton
            android:id="@+id/miImageButton"
            android:layout_width="350dp"
            android:layout_height="350dp"
            android:src="@drawable/imagen2"
            android:scaleType="centerInside"
            android:contentDescription="Imagen principal" />

        <!-- Texto debajo de la imagen -->
        <TextView
            android:id="@+id/texto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="probando el text view"
            android:textColor="#CDDC39"
            android:textSize="14sp"
            android:textStyle="bold"
            android:typeface="monospace" />

        <!-- Botón Parar -->
        <Button
            android:id="@+id/miBotonParar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Parar" />

        <!-- Botón Mover -->
        <Button
            android:id="@+id/miBotonMover"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Mover" />

        <!-- Botón Rotar -->
        <Button
            android:id="@+id/miBotonRotar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Rotar" />

        <!-- ToggleButton -->
        <ToggleButton
            android:id="@+id/miToggleButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textOff="No pulsado"
            android:textOn="Pulsado" />

        <Spinner
            android:id="@+id/miSpinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"/>


    </LinearLayout>
</ScrollView>